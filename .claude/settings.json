{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push:*)",
      "Read(./.env)",
      "Read(./api/.env)",
      "Read(./web/.env)"
    ],
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(git push:*)"
    ]
  }
}
