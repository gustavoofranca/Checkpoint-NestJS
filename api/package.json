{
  "name": "checkpoint-api",
  "version": "0.0.0",
  "private": true,
  "description": "Game catalog API",
  "license": "MIT",
  "engines": {
    "node": ">=24.7 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch --env-file ../.env",
    "build": "nest build",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "db:migrate": "prisma migrate deploy",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "node --env-file-if-exists=../.env dist/cli/seed.js",
    "admin:promote": "node --env-file-if-exists=../.env dist/cli/promote-admin.js",
    "snapshot:build": "node dist/cli/build-steam-snapshot.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
