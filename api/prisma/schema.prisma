generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// CHECK constraints and the pg_trgm extension cannot be expressed here; they live as commented
// raw SQL in the migrations. Primary keys are UUID v7, generated by Prisma Client (docs/adr/0002).

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum LibraryStatus {
  BACKLOG
  PLAYING
  COMPLETED
  DROPPED

  @@map("library_status")
}

enum SyncTrigger {
  SCHEDULED
  MANUAL

  @@map("sync_trigger")
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("sync_status")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique @db.VarChar(254)
  username     String   @unique @db.VarChar(24)
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens  RefreshToken[]
  reviews        Review[]
  libraryEntries LibraryEntry[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  // SHA-256 of the opaque token, hex encoded. The token itself is never stored.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("Rotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Game {
  id               String    @id @default(uuid(7)) @db.Uuid
  steamAppId       Int       @unique @map("steam_app_id")
  slug             String    @unique @db.VarChar(120)
  title            String    @db.VarChar(200)
  // Application-computed key for the title sort: lowercase, accents and trademark signs removed.
  // Sorting by it does not depend on the database locale (docs/adr/0005).
  titleSort        String    @map("title_sort") @db.VarChar(200)
  shortDescription String    @map("short_description") @db.VarChar(1000)
  headerImageUrl   String    @map("header_image_url") @db.VarChar(500)
  releaseDate      DateTime? @map("release_date") @db.Date
  developers       String[]
  publishers       String[]
  isFree           Boolean   @map("is_free")
  priceCents       Int?      @map("price_cents")
  currency         String?   @db.Char(3)
  ratingAverage    Decimal   @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount      Int       @default(0) @map("rating_count")
  syncedAt         DateTime  @map("synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  genres         GameGenre[]
  reviews        Review[]
  libraryEntries LibraryEntry[]

  // One index per filter and sort the API offers: title search, and the newest, top_rated and
  // title sorts. The id breaks ties so cursor pagination has a total order.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "games_title_trgm_idx")
  @@index([releaseDate, id])
  @@index([ratingAverage, id])
  @@index([titleSort, id])
  @@map("games")
}

model Genre {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(60)
  slug      String   @unique @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  games GameGenre[]

  @@map("genres")
}

model GameGenre {
  gameId    String   @map("game_id") @db.Uuid
  genreId   String   @map("genre_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
  @@index([genreId])
  @@map("game_genres")
}

model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  rating    Int      @db.SmallInt
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
  @@map("reviews")
}

model LibraryEntry {
  userId    String        @map("user_id") @db.Uuid
  gameId    String        @map("game_id") @db.Uuid
  status    LibraryStatus
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
  @@map("library_entries")
}

model SyncRun {
  id             String      @id @default(uuid(7)) @db.Uuid
  trigger        SyncTrigger
  status         SyncStatus
  startedAt      DateTime    @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?   @map("finished_at") @db.Timestamptz(6)
  gamesProcessed Int         @default(0) @map("games_processed")
  gamesFailed    Int         @default(0) @map("games_failed")
  errorMessage   String?     @map("error_message") @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@map("sync_runs")
}
