# Copy to .env and fill in every empty value. .env is git-ignored; never commit it.
# Generate each password and the JWT secret with: openssl rand -hex 32

# development | test | production. production disables pretty logs.
NODE_ENV=development

# HTTP port of the API.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API with credentials. No paths.
CORS_ORIGINS=http://localhost:5173

# Swagger UI at /api/v1/docs. Always on outside production; in production only when "true".
ENABLE_DOCS=false

# PostgreSQL container (docker-compose.yml). Host port 5433.
POSTGRES_USER=checkpoint
POSTGRES_DB=checkpoint
POSTGRES_PASSWORD=

# Connection string the API uses. Put the same password as POSTGRES_PASSWORD after "checkpoint:".
# Tests use the sibling database checkpoint_test, created on first run.
DATABASE_URL=postgresql://checkpoint:@localhost:5433/checkpoint

# Redis container password, and the URL the API uses with the same password after "redis://:".
REDIS_PASSWORD=
REDIS_URL=redis://:@localhost:6379

# HS256 signing key for access tokens. At least 32 bytes; the API refuses to start otherwise.
JWT_SECRET=

# Password of the two demo accounts that `npm run db:seed` creates (12 to 128 characters).
# Only the seed reads it; local development data, never a production account.
SEED_DEMO_PASSWORD=
